# ══════════════════════════════════════════════
#   MARCO MALIK MD BOT v5.0 — Environment Config
# ══════════════════════════════════════════════

# ✅ SESSION ID — Pairing website سے ملی ID یہاں لگائیں
SESSION_ID=MARCO_MALIK_&_SYED-MD~

# Bot Settings
BOT_NAME=Marco Malik MD Bot
OWNER_NAME=Marco Malik
OWNER_NUMBER=923001234567
PREFIX=.
MODE=public
VERSION=5.0

# Auth Session Directory
AUTH_DIR=auth_info

# ══════════════════════════════════════════════
# MENU IMAGE — .menu command کے ساتھ picture
# ══════════════════════════════════════════════
# Option 1: Internet سے URL لگائیں
# MENU_IMAGE=https://i.imgur.com/your-image.jpg
#
# Option 2: اپنی picture کو images/ folder میں رکھیں
# پھر صرف filename لکھیں:
# MENU_IMAGE=images/menu.jpg
#
# Option 3: خالی چھوڑیں — صرف text menu آئے گا
MENU_IMAGE=

# OpenAI (for .ai .gpt .imagine commands)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-3.5-turbo

# News API (for .news command) — free at newsapi.org
NEWS_API_KEY=your-news-api-key

# Weather API (for .weather command) — free at openweathermap.org
WEATHER_API_KEY=your-weather-api-key

# Links
CHANNEL_LINK=https://whatsapp.com/channel/your-channel-id
REPO_LINK=https://github.com/M-M-MALIKxMD/marco-malik_md
CONTACT_LINK=https://wa.me/923001234567
HEROKU_LINK=https://heroku.com/deploy?template=https://github.com/M-M-MALIKxMD/marco-malik_md
RAILWAY_LINK=https://railway.app/new/template?template=https://github.com/M-M-MALIKxMD/marco-malik_md

# Auto Features (true/false)
ANTI_LINK=false
ANTI_DELETE=true
AUTO_READ=false
AUTO_REACT=true
AUTO_STATUS_READ=true
AUTO_RECORD=false
ANTI_CALL=true
